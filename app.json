{
  "expo": {
    "name": "MyBoringPasswords",
    "slug": "MyBoringPasswords",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "myboringpasswords",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myboring.passwords"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.myboring.passwords"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
